# Homebrew on macOS
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# OrbStack
source ~/.orbstack/shell/init.zsh 2>/dev/null || :

# JVM via Coursier
export JAVA_HOME="$HOME/Library/Caches/Coursier/arc/https/cdn.azul.com/zulu/bin/zulu21.46.19-ca-jdk21.0.9-macosx_aarch64.tar.gz/zulu21.46.19-ca-jdk21.0.9-macosx_aarch64"
export PATH="$PATH:$HOME/Library/Application Support/Coursier/bin"
